# Production : copier ce fichier en .env.prod (jamais commité) et le remplir.
# Lu par compose.prod.yaml pour les conteneurs app, scheduler, web et db.

# Adresse publique servie par Caddy. Un nom de domaine qui pointe vers le
# serveur obtient un certificat HTTPS automatiquement (ports 80 et 443 ouverts).
# Essai sur sa machine : SITE_ADDRESS=http://localhost et APP_URL=http://localhost
SITE_ADDRESS=gestion.exemple.sn
APP_URL=https://gestion.exemple.sn

APP_NAME="Borom Daradji"
# Générer avec : make prod-key
APP_KEY=
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
LOG_LEVEL=warning

# Base PostgreSQL (conteneur db). Mot de passe long.
DB_DATABASE=borom
DB_USERNAME=borom
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Envoi d'emails : aucun pour l'instant (journal seulement).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="contact@exemple.sn"
MAIL_FROM_NAME="Borom Daradji"

# Borom Daradji (valeurs par défaut de config/borom.php, à valider avec le client)
SANCTUM_EXPIRATION=43200
ACTIVITY_RETENTION_DAYS=365
INVOICE_DUE_DAYS=15
RENT_DUE_DAY=5
