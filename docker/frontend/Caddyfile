# Serveur web de production : HTTPS automatique (Let's Encrypt) dès que
# SITE_ADDRESS est un nom de domaine qui pointe vers le serveur.
# Pour un essai sur sa machine : SITE_ADDRESS=http://localhost

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	request_body {
		max_size 100MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# API Laravel et sonde de santé : PHP-FPM du conteneur « app ».
	@laravel path /api/* /up
	handle @laravel {
		root * /var/www/html/public
		rewrite * /index.php
		reverse_proxy {$PHP_FPM_ADDRESS:app:9000} {
			transport fastcgi {
				split .php
			}
		}
	}

	# Photos et logos publics (volume partagé avec l'API, en lecture seule).
	handle_path /storage/* {
		root * /srv/storage
		file_server
	}

	# Site vitrine et back-office (application React) ; toute autre adresse
	# renvoie index.html, le routeur React prend le relais.
	handle {
		root * /srv/www
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Le service worker et la page d'accueil doivent toujours être relus : sinon une mise à jour
		# reste bloquée sur les téléphones.
		@fresh path /sw.js /index.html /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
